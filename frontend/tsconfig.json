{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@hushh/sdk": [
        "../midnight/src/sdk/index.ts"
      ],
      "@hushh/sdk/*": [
        "../midnight/src/sdk/*"
      ],
      "@midnight-ntwrk/compact-runtime": ["./node_modules/@midnight-ntwrk/compact-runtime"],
      "@midnightntwrk/midnight-js-contracts": ["./node_modules/@midnightntwrk/midnight-js-contracts"],
      "@noble/hashes/*": ["./node_modules/@noble/hashes/*"],
      "tweetnacl": ["./node_modules/tweetnacl"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "legacy-arc"
  ]
}
