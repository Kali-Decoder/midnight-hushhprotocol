# Hushh frontend · Midnight
#
# ─── Network ─────────────────────────────────────────────────────────
# undeployed = local devnet (../midnight: npm run localnet:up && npm run deploy)
# preview | preprod = public testnets (connect 1AM or Lace)
NEXT_PUBLIC_MIDNIGHT_NETWORK=undeployed

# connector = 1AM / Lace (default off localnet)
# dev       = localnet genesis wallet inside the page (default on localnet)
# NEXT_PUBLIC_WALLET_MODE=dev

# Contract addresses default to ../midnight/deployments/<network>.json
# (copied in by `pnpm zk:sync`, which runs before dev/build).
# NEXT_PUBLIC_VAULT_ADDRESS=
# NEXT_PUBLIC_REGISTRY_ADDRESS=

# Localnet endpoints (defaults shown). Connector mode reads endpoints from the wallet.
# NEXT_PUBLIC_MIDNIGHT_INDEXER_URL=http://localhost:8088/api/v4/graphql
# NEXT_PUBLIC_MIDNIGHT_INDEXER_WS_URL=ws://localhost:8088/api/v4/graphql/ws
# NEXT_PUBLIC_MIDNIGHT_NODE_URL=http://localhost:9944
# NEXT_PUBLIC_MIDNIGHT_PROOF_SERVER_URL=http://127.0.0.1:6300

# Optional block explorer base URL (links render only when set).
# NEXT_PUBLIC_EXPLORER_URL=

# ─── X (Twitter) via Privy ───────────────────────────────────────────
NEXT_PUBLIC_PRIVY_APP_ID=
# Server only: lets /api/social/attest read the user's linked X account.
PRIVY_APP_SECRET=

# ─── Social attester (server only) ───────────────────────────────────
# Jubjub secret whose public key the night_registry was deployed with.
# On localnet it defaults to ../midnight/.secrets/attester-local.json.
# ATTESTER_SECRET=
# Localnet demos without Privy: trust the typed X handle. NEVER in production.
# ATTESTER_DEV_MODE=1
